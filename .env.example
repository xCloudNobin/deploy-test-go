# Taskboard environment example — copy to .env or export in your shell.
# Every value below is a safe, non-secret default. There is no authentication
# in this public demo app, so nothing here grants access beyond the process.

# TCP port the HTTP server listens on. The bind host is always 0.0.0.0 so the
# process is reachable from outside the container/host.
PORT=8080

# Absolute path to the persistent SQLite database file. It MUST live outside
# the release checkout (for example /var/lib/taskboard/board.db or a mounted
# volume) so that data survives redeploy. The directory is created if missing.
# Set to :memory: for throwaway tests only — in-memory data is lost on exit.
SQLITE_PATH=/var/lib/taskboard/board.db

# Optional: SQLITE_PATH is the canonical variable; DB_PATH is accepted as an
# alias. Only one is used.
# DB_PATH=/var/lib/taskboard/board.db